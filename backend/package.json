{
  "name": "backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker for jacobjbeal.com. Serves the built frontend and the /api routes.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build:frontend && wrangler deploy",
    "build:frontend": "cd ../frontend && npm run build",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types src/worker-configuration.d.ts",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.165.0"
  }
}
